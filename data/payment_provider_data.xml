<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <record id="account_payment_method_airwallex" model="account.payment.method">
        <field name="name">Airwallex</field>
        <field name="code">airwallex</field>
        <field name="payment_type">inbound</field>
    </record>

    <record id="payment_provider_airwallex" model="payment.provider">
        <field name="name">Airwallex</field>
        <field name="code">airwallex</field>
        <field name="state">test</field>
        <field name="is_published">True</field>
        <field name="image_128" type="base64" file="payment_airwallex/static/description/icon.png"/>
        <field name="inline_form_view_id" ref="payment_airwallex.airwallex_inline_form"/>
        
        <field name="payment_method_ids" eval="[
            Command.set([
                ref('payment.payment_method_card'),
            ])
        ]"/>
    </record>
</odoo>